@page
@using Sankirtana.Web.Business.Books
@model Sankirtana.Web.Pages.EditBook

@{
    ViewData["Title"] = Model.IsNew ? "Добавить книгу" : "Редактировать книгу";
}

<h1>@ViewData["Title"]</h1>
<form method="post" asp-antiforgery="true" class="form-surface">
    <input type="hidden" asp-for="Input.Id" />
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Category" class="form-label"></label>
        <select asp-for="Input.Category" class="form-select">
            <option value="">Не выбрано</option>
            <option value="@BookCategory.MahaBig">Маха-Биг</option>
            <option value="@BookCategory.Big">Биг</option>
            <option value="@BookCategory.Medium">Средняя</option>
            <option value="@BookCategory.Small">Маленькая</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.VolumePoints" class="form-label"></label>
        <input asp-for="Input.VolumePoints" class="form-control" inputmode="decimal" aria-describedby="volume-points-help" />
        <div id="volume-points-help" class="form-text">Пустое поле оставит стандартные баллы выбранной категории.</div>
        <span asp-validation-for="Input.VolumePoints" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>
