@page
@model Sankirtana.Web.Pages.Books.IndexBooksPageModel

@{
  ViewBag.Title = "Справочник книг";
  var canManageBooks = User.IsInRole(PortalRoles.Administrator);
}

<div>
  @if (canManageBooks)
  {
    <a asp-page="/Books/EditBook" class="btn btn-primary">Добавить книгу</a>
  }
  <table class="table">
    <thead>
    <tr>
      <th scope="col">Название</th>
      <th scope="col">Категория</th>
      <th scope="col">Баллы</th>
      @if (canManageBooks)
      {
        <th scope="col" class="text-end">Действия</th>
      }
    </tr>
    </thead>
    <tbody>
    @foreach (var book in Model.BookList)
    {
      <tr>
        <td>
          @if (canManageBooks)
          {
            <a asp-page="/Books/EditBook" asp-route-id="@book.Id">@book.Name</a>
          }
          else
          {
            @book.Name
          }
        </td>
        <td>@book.Category</td>
        <td>@book.VolumePoints</td>
        @if (canManageBooks)
        {
          <td class="text-end">
            <form method="post" asp-page="/Books/DeleteBook">
              <input type="hidden" name="id" value="@book.Id"/>
              <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить книгу?')">Удалить</button>
            </form>
          </td>
        }
      </tr>
    }
    </tbody>
  </table>
</div>
