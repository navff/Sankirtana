@page
@model Sankirtana.Web.Pages.Books.IndexBooksPageModel

@{
  ViewBag.Title = "Справочник книг";
}

<div class="page-heading">
  <h1>@ViewBag.Title</h1>
  <a asp-page="/Books/EditBook" class="btn btn-primary">Добавить книгу</a>
</div>
<div class="table-responsive table-surface">
  <table class="table">
    <thead>
    <tr>
      <th scope="col">Название</th>
      <th scope="col">Категория</th>
      <th scope="col">Баллы</th>
      <th scope="col" class="text-end">Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var book in Model.BookList)
    {
      <tr>
        <td><a asp-page="/Books/EditBook" asp-route-id="@book.Id">@book.Name</a></td>
        <td>@book.Category</td>
        <td>@book.VolumePoints</td>
        <td class="text-end">
          <form method="post" asp-page="/Books/DeleteBook">
            <input type="hidden" name="id" value="@book.Id"/>
            <button type="submit" class="btn btn-sm btn-danger" aria-label="Удалить книгу" onclick="return confirm('Удалить книгу?')">
              <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>
