<!DOCTYPE html>
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    string? Current(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<html lang="ru">
<head>
    <meta name="robots" content="noindex"/> 
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="icon" type="image/x-icon" href="~/favicon.png">
    <title>@ViewData["Title"] — Книги людям</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body>
<header>
    <nav class="navbar navbar-expand-md navbar-light site-navbar" aria-label="Главное меню">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index"><img src="~/logo.png" alt="Книги людям" class="logo"/></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primary-menu" aria-controls="primary-menu"
                    aria-expanded="false" aria-label="Главное меню">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="primary-menu">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Reports/AllDay" aria-current="@Current("/Reports/AllDay")">Статистика</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Dashboard/Index" aria-current="@Current("/Dashboard/Index")">Дашборд</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Books/Index" aria-current="@Current("/Books/Index")">Книги</a>
                    </li>
                    @if (User.IsInRole(PortalRoles.Administrator))
                    {
                        <li class="nav-item">
                            <a class="nav-link admin-nav-link" asp-page="/Users/Index" aria-current="@Current("/Users/Index")">
                                <span class="nav-lock" aria-hidden="true"></span>Пользователи<span class="visually-hidden"> (только для администраторов)</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main class="container site-content">
    @RenderBody()
</main>

@if (User.Identity?.IsAuthenticated == true)
{
    <footer class="site-footer">
        <div class="container">@User.Identity.Name</div>
    </footer>
}
</body>
</html>
